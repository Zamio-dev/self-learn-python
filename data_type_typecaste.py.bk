print(f"\n\n=====>\tDemo of types and type casting\t<=====\n\n")
variable_1=1
variable_2="this is a string"
variable_3=1.32
variable_5=True
variable_7=[1,2,3,4]
variable_8={"name":"Sameer"}
variable_9={1,2,3,4}
variable_10=b"hello"

print(f"{variable_1=}	==>	type: {type(variable_1)} -> new type: {type(float(variable_1))=}\n")
print(f"{variable_2=}	==>	type: {type(variable_2)}\n")
print(f"{variable_3=}	==>	type: {type(variable_3)} -> new type: {type(int(variable_3))=}\n")
print(f"{variable_5=}	==>	type: {type(variable_5)} -> new type: {str(int(variable_3))=}\n")
print(f"{variable_7=}	==>	type: {type(variable_7)}\n")
print(f"{variable_8=}	==>	type: {type(variable_8)}\n")
print(f"{variable_9=}	==>	type: {type(variable_9)}\n")
print(f"{variable_10=}	==>	type: {type(variable_10)}\n")
